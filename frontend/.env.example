# VITE_* values are public and embedded in the browser bundle.
# Browser-reachable Strapi origin, without /api or a trailing slash.
VITE_API_BASE_URL=http://localhost:1337
# Optional public, least-privilege token only; never use admin tokens or private keys.
VITE_API_TOKEN=
# Restart development or rebuild production assets after changes.
# Docker production builds use --build-arg values instead of .env files.
