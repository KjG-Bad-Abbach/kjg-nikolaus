# Environment variables for AI Agents scripts
#
# Here you can configure the default behavior of the scripts
# for your local development environment.
#
# Copy this file to .env and edit the values as needed.
# The scripts will automatically load the .env file if it exists.

#########################
# Machine-wide settings #
#########################

# Nix store
# For Linux it can be left empty (will be auto-detected)
# For MacOS it should be set to the name of the volume where the nix store should be mounted (e.g. "nix-store")
# NIX_VOLUME_NAME= # Linux
# NIX_VOLUME_NAME=nix-store # MacOS

#####################################
# Repo- or Folder-specific settings #
#####################################
# Hint: remember to use "export VAR_NAME=value" format when setting variables in .envrc files

# If you want to use a specific editor for commit messages or other editing tasks
# EDITOR=vim

# Base image for the dev container (e.g. "ubuntu:22.04")
# NIX_DEV_CONTAINER_BASE_IMAGE=

# Extra arguments for the docker buildx build command when building the dev container image (e.g. "--platform linux/amd64")
# NIX_DEV_CONTAINER_DOCKER_BUILD_EXTRA_ARGS=

# Extra arguments for the docker run command when starting the dev container (e.g. "-v /path/on/host:/path/in/container" or "--platform linux/amd64")
# NIX_DEV_CONTAINER_DOCKER_RUN_EXTRA_ARGS=

# Port mappings for the dev container (e.g. "8080:80,8443:443" or "8080:80 8443:443" or "8080,8443" or "8080 8443")
# NIX_DEV_CONTAINER_PORT_MAPPINGS=

# Nix installation mode inside container (single-user or multi-user)
# NIX_DEV_CONTAINER_NIX_INSTALLATION_TYPE=

# Named docker volume for /nix inside container (forces multi-user mode)
# NIX_DEV_CONTAINER_NIX_VOLUME_NAME=

# Force mounting parent .git dir for git worktrees (1 to enable, 0 to disable)
# GIT_WORKTREE_MOUNT_GIT_DIR=

# Command to run after the dev container is created (e.g. "nix profile add nixpkgs#jujutsu && jujutsu --version")
# NIX_DEV_CONTAINER_POST_CREATE_BASH_CMD="git config something ...; nix profile add nixpkgs#jujutsu && jj config set --user user.name \"Your Name\" && jj config set --user user.email \"your.email@example.com\" && echo 'jj setup complete'"

# Extra arguments for the docker buildx build command when building the nix-daemon image (e.g. "--platform linux/amd64")
# NIX_DEV_CONTAINER_DOCKER_NIX_DAEMON_BUILD_EXTRA_ARGS=

# Extra arguments for the docker run command when starting the nix-daemon container (e.g. "--platform linux/amd64")
# NIX_DEV_CONTAINER_DOCKER_NIX_DAEMON_RUN_EXTRA_ARGS=

########################
# Application settings #
########################

# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=tobemodified
DATABASE_PORT=5432
DATABASE_NAME=tobemodified
DATABASE_USERNAME=tobemodified
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
DATABASE_FILENAME=
JWT_SECRET=tobemodified

# PgAdmin
PGADMIN_DEFAULT_EMAIL=tobemodified
PGADMIN_DEFAULT_PASSWORD=tobemodified

# Frontend
API_TOKEN=tobemodified
API_BASE_URL=tobemodified
