    {
      "type": "paragraph",
      "children": [{ "type": "text", "text": "{{button('Buchung ansehen')}}" }]
    },
    {
      "type": "paragraph",
      "children": [{ "type": "text", "text": "Deine KjG Bad Abbach." }]
    }
