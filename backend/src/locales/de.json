  "verification_email_subject_template": "E-Mail verifiziert - Vervollständige deine Buchung",
  "verification_email_body_template": [
    {
      "type": "paragraph",
      "children": [
        { "type": "text", "text": "E-Mail erfolgreich verifiziert!" }
      ]
    },
    {
      "type": "paragraph",
      "children": [
        { "type": "text", "text": "Hallo {{first_name}} {{last_name}}," }
      ]
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
