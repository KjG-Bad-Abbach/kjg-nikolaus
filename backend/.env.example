
# Server
HOST=0.0.0.0
PORT=1337

# Public URLs are managed only through the backend environment, not Config.
# Use browser-reachable absolute HTTP(S) URLs without credentials.
# Set these values before opening bookings; restart after changing them.
BASE_URL=
API_BASE_URL=

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=tobemodified
DATABASE_PORT=5432
DATABASE_NAME=tobemodified
DATABASE_USERNAME=tobemodified
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
DATABASE_FILENAME=
JWT_SECRET=tobemodified
