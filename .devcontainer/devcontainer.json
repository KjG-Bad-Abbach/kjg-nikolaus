// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
		"ghcr.io/devcontainers/features/nix:1.4.0": {
			"multiUser": true
		}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
	"workspaceFolder": "${localWorkspaceFolder}",
	"mounts": [
		// Uncomment the next line to mount your worktree's parent git repository
		// "source=${localWorkspaceFolder}/../your-parent-git,target=${localWorkspaceFolder}/../your-parent-git,type=bind,consistency=cached",
		// // For a shared host Nix store, switch both Nix mounts to the bind pair below.
		// "source=/nix,target=/nix,type=bind",
		// "source=${localEnv:HOME}/.cache/nix,target=/home/vscode/.cache/nix,type=bind,consistency=cached",
		// // For architecture-specific stores, use the same volume prefix for the store and its -cache volume.
		// "source=nix-volume,target=/nix,type=volume",
		// "source=nix-volume-cache,target=/home/vscode/.cache/nix,type=volume",
		// // AI Agents folders (in devcontainer volumes)
		// "source=ai-agents-config,target=/home/vscode/.config/ai-agents,type=volume",
		// "source=opencode-local-auth,target=/home/vscode/.local/share/opencode,type=volume",
		// "source=opencode-cache,target=/home/vscode/.cache/opencode,type=volume",
		// "source=opencode-config,target=/home/vscode/.config/opencode,type=volume"
		// // AI Agents folders (bind to user's HOME)
		// // Switch the entire AI Agents block together; create host bind directories before container creation.
		// // For the cache binds: mkdir -p "$HOME/.cache/opencode" (and "$HOME/.cache/nix" for the host Nix pair).
		// "source=${localEnv:HOME}/.config/ai-agents,target=/home/vscode/.config/ai-agents,type=bind,consistency=cached",
		// "source=${localEnv:HOME}/.local/share/opencode,target=/home/vscode/.local/share/opencode,type=bind,consistency=cached",
		// "source=${localEnv:HOME}/.cache/opencode,target=/home/vscode/.cache/opencode,type=bind,consistency=cached",
		// "source=${localEnv:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind,consistency=cached"
	],
	"containerEnv": {
		// Ensure that Nix profile is sourced in terminals
		"__ETC_PROFILE_NIX_SOURCED": ""
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/post-create.sh",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"jnoortheen.nix-ide",
				"vivaxy.vscode-conventional-commits",
				"mhutchie.git-graph",
				"letmaik.git-tree-compare",
				"jj-view.jj-view",
				"sleistner.vscode-fileutils",
				"Asuka.insertnumbers",
				"heaths.vscode-guid",
				"shardulm94.trailing-spaces",
				"EditorConfig.EditorConfig",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-german",
				"aaron-bond.better-comments",
				"chrmarti.regex",
				"humao.rest-client",
				"bierner.markdown-mermaid",
				"mitchdenny.ecdc",
				"bradlc.vscode-tailwindcss",
				"ecmel.vscode-html-css",
				"formulahendry.auto-rename-tag",
				"esbenp.prettier-vscode"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
